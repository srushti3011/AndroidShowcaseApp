<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".authenticationflow.view.SignUpActivity"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="15dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCreateAccountHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="10dp"
                android:layout_marginStart="30dp"
                android:text="@string/signup_create_account_heading"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:textSize="20sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCreateAccountSubHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/tvCreateAccountHeading"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="5dp"
                android:layout_marginStart="30dp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:textStyle="bold"
                android:text="@string/signup_subheading" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNameHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="20dp"
                android:text="@string/name_heading"
                android:fontFamily="@font/poppins_regular"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/appSubHeadsBlack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCreateAccountSubHeading" />

            <com.example.recipeapp.customview.RecipeAppEditText
                android:id="@+id/etName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvNameHeading" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEmailHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="20dp"
                android:text="@string/email_heading"
                android:fontFamily="@font/poppins_regular"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/appSubHeadsBlack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etName" />

            <com.example.recipeapp.customview.RecipeAppEditText
                android:id="@+id/etEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvEmailHeading" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPasswordHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="20dp"
                android:text="@string/password_heading"
                android:fontFamily="@font/poppins_regular"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/appSubHeadsBlack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etEmail" />

            <com.example.recipeapp.customview.RecipeAppEditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPasswordHeading" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvConfirmPasswordHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="20dp"
                android:text="@string/confirm_password_heading"
                android:fontFamily="@font/poppins_regular"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/appSubHeadsBlack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etPassword" />

            <com.example.recipeapp.customview.RecipeAppEditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvConfirmPasswordHeading" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkBoxAcceptConditions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/etConfirmPassword"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="40dp"
                android:textColor="@color/colorTertiary"
                android:text="@string/checkbox_accept_terms_conditions"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:layout_marginTop="20dp"
                android:button="@drawable/checkbox_custom"
                android:paddingStart="10dp"
                android:paddingEnd="0dp"
                android:buttonTintMode="add" />

            <io.writeopia.loadingbutton.customViews.CircularProgressButton
                android:id="@+id/btnSignUp"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="30dp"
                style="@style/Widget.AppCompat.Button"
                android:background="@drawable/app_button_bg"
                android:drawableEnd="@drawable/arrow_forward"
                android:drawablePadding="-120dp"
                android:paddingStart="0dp"
                android:paddingEnd="90dp"
                android:text="@string/sign_up_button"
                android:fontFamily="@font/poppins_regular"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/checkBoxAcceptConditions" />

            <View
                android:id="@+id/viewLeft"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="90dp"
                android:layout_marginEnd="10dp"
                android:background="@color/colorSecondary"
                app:layout_constraintBottom_toBottomOf="@id/tvSignInOptions"
                app:layout_constraintEnd_toStartOf="@+id/tvSignInOptions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvSignInOptions" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSignInOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/sign_in_option_heading"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/colorSecondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnSignUp" />

            <View
                android:id="@+id/viewRight"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="90dp"
                android:background="@color/colorSecondary"
                app:layout_constraintBottom_toBottomOf="@id/tvSignInOptions"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvSignInOptions"
                app:layout_constraintTop_toTopOf="@id/tvSignInOptions" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cvGoogle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                app:cardElevation="5dp"
                app:cardCornerRadius="10dp"
                app:layout_constraintEnd_toStartOf="@+id/cvFacebook"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSignInOptions"
                android:layout_marginEnd="25dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:src="@drawable/google_logo"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cvFacebook"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:cardElevation="5dp"
                app:cardCornerRadius="10dp"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toEndOf="@+id/cvGoogle"
                app:layout_constraintTop_toBottomOf="@+id/tvSignInOptions">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:background="@android:color/transparent"
                        android:src="@drawable/facebook_logo"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvGoToSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/cvFacebook"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="20dp"
                android:textColor="@color/appSubHeadsBlack"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/signup_go_to_login" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>